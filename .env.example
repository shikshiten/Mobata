# =====================================================================
# Mobata Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# =====================================================================

# 1. Telegram API Credentials (Get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# 2. Your Telegram Phone Number (with country code, e.g. +1234567890 or +919876543210)
TELEGRAM_PHONE=+1234567890

# 3. Destination Channel
# Option A: Channel ID (Private channels usually start with -100, e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890
# Option B: Invite Link (e.g. https://t.me/+AbCdEfGhIjK)
TELEGRAM_INVITE_LINK=

# 4. Path to Media Folder (contains photos/videos to upload)
# Windows example: C:\Users\YourName\Pictures\Upload
# Linux/Mac example: /home/user/uploads
UPLOAD_FOLDER=./media_uploads

# 5. Delay between uploads in seconds (avoids hitting Telegram rate limits)
UPLOAD_DELAY=0.5
